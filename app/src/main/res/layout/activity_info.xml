<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TŁO -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/info_bg"
        android:scaleType="centerCrop"/>

    <!-- Przyciemnienie -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB000000"/>

    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="8dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progress="66"
                android:max="100"
                android:progressTint="#FFFFFF"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Czym jest inżynieria biomedyczna?"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inżynieria biomedyczna to interdyscyplinarna dziedzina łącząca nauki techniczne, informatykę oraz medycynę. Jej celem jest tworzenie nowoczesnych technologii wspomagających diagnostykę, terapię oraz monitorowanie zdrowia pacjentów."
                android:textColor="#F1F5F9"
                android:textSize="19sp"
                android:lineSpacingExtra="8dp"
                android:layout_marginBottom="40dp"/>

            <Button
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Przejdź dalej"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#14B8A6"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>